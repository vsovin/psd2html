# Порт HTTP-сервера
PORT=3000

# Пароль для входа в мини-CMS (/admin.html). Меняется без перезапуска не требуется — перезапустите сервер.
ADMIN_PASSWORD=change-me-strong-password

# --- Email заявок (опционально). Если SMTP_HOST пуст — письма не шлются, заявки пишутся в data.json ---
SMTP_HOST=smtp.your-provider.ru
SMTP_PORT=465
SMTP_USER=noreply@virshketech.com
SMTP_PASS=app-password
MAIL_FROM="VirshkeTech <noreply@virshketech.com>"
ORDER_EMAIL=sales@virshketech.com

# --- Дополнительно: webhook (Telegram-бот, CRM). Оставьте пустым, если не нужен ---
WEBHOOK_URL=
