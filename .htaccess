# VirshkeTech.com — конфиг виртуального хостинга (Apache)

# --- Чистые URL: /cnc-pro/ вместо /cnc-pro/index.html ---
Options -MultiViews
RewriteEngine On
RewriteBase /

# Убираем index.html из адресной строки (301)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^\s]/?)index\.html[\s?] [NC]
RewriteRule ^(.*/?)index\.html$ /$1 [R=301,L]

# Внутренний редирект каталога на его index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+?)/?$ $1/index.html [L]

# --- MIME-типы ---
AddType image/svg+xml .svg
AddType application/javascript .js
AddType text/css .css

# --- Базовые настройки безопасности ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
Options -Indexes

# --- Сжатие ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Кэширование статики ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Обработка формы заказа (POST /api/order) ---
# На статическом хостинге JS-заглушка сама имитирует успех и ведёт на /thanks/.
# Для реальной отправки заявок подключите обработчик (пример с PHP):
# RewriteRule ^api/order$ api/order.php [L]
